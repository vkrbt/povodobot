{
  "name": "meet-bot",
  "version": "0.1.0",
  "description": "Telegram bot that posts a daily weather card for Minsk and a sunset attendance poll",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('src','templates'),d=p.join('dist','templates');fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s))fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "today": "ts-node src/cli/today.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/node": "20.19.39",
    "@types/node-cron": "3.0.11",
    "dayjs": "1.11.20",
    "dotenv": "16.6.1",
    "node-cron": "3.0.3",
    "puppeteer": "22.15.0",
    "telegraf": "4.16.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "ts-node": "10.9.2"
  }
}
