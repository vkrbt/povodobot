{
  "name": "meet-bot",
  "version": "0.1.0",
  "description": "Telegram bot that posts a daily weather card for Minsk and a sunset attendance poll",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('src','templates'),d=p.join('dist','templates');fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s))fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "fetch-fonts": "node -e \"const fs=require('fs'),p=require('path'),h=require('https');const d=p.join('assets','fonts');fs.mkdirSync(d,{recursive:true});const targets=[{file:'AppleColorEmoji-Linux.ttf',url:'https://github.com/samuelngs/apple-emoji-ttf/releases/latest/download/AppleColorEmoji-Linux.ttf',min:1e6},{file:'Inter-Variable.woff2',url:'https://rsms.me/inter/font-files/InterVariable.woff2',min:1e5},{file:'Inter-Variable-Italic.woff2',url:'https://rsms.me/inter/font-files/InterVariable-Italic.woff2',min:1e5}];function get(u,f,cb){h.get(u,{headers:{'User-Agent':'povodobot'}},r=>{if(r.statusCode>=300&&r.statusCode<400&&r.headers.location){get(r.headers.location,f,cb);return}if(r.statusCode!==200){console.error('http',r.statusCode,'for',u);process.exit(1)}const o=fs.createWriteStream(f);r.pipe(o);o.on('finish',()=>{o.close();console.log('fetched',f,fs.statSync(f).size,'bytes');cb()})}).on('error',e=>{console.error(e);process.exit(1)})}function next(i){if(i>=targets.length)return;const t=targets[i],f=p.join(d,t.file);if(fs.existsSync(f)&&fs.statSync(f).size>t.min){console.log('already present',f);next(i+1);return}get(t.url,f,()=>next(i+1))}next(0)\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "today": "ts-node src/cli/today.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "20.19.39",
    "@types/node-cron": "3.0.11",
    "dayjs": "1.11.20",
    "dotenv": "16.6.1",
    "node-cron": "3.0.3",
    "puppeteer": "22.15.0",
    "telegraf": "4.16.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "ts-node": "10.9.2"
  }
}
