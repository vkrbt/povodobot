# Telegram
BOT_TOKEN=123456:your-bot-token

# Один или несколько чатов через запятую — туда уходят карточка и опрос
CHAT_IDS=-1001234567890,-1002400308378
# Для одного чата можно использовать CHAT_ID (обратная совместимость):
# CHAT_ID=-1001234567890

# Schedule (ежедневно в 12:00 по Europe/Minsk)
CRON_SCHEDULE=0 12 * * *
TIMEZONE=Europe/Minsk

# Location
CITY_NAME=Минск
LATITUDE=53.9
LONGITUDE=27.5667

# Card
CARD_WIDTH=1080
CARD_HEIGHT=1080
OUTPUT_PATH=output/weather-card.png

# Poll
# За сколько минут до заката встречаемся — подставится в {meetBefore}.
POLL_MEET_BEFORE_MIN=20
# Один или несколько шаблонов вопроса через `|`. Плейсхолдеры: {sunset}, {meetBefore}.
# Если не задано — используется встроенный набор из нескольких вариантов.
# POLL_QUESTIONS=Смотрим закат сегодня в {sunset}, встречаемся за ~{meetBefore} минут до заката|Сегодня закат в {sunset} — сбор за {meetBefore} минут до. Кто с нами?
POLL_OPTION_YES=🌇 Дааа, смотрим вместе
POLL_OPTION_CHAT=💬 Смотрю с вами, но в чате
POLL_OPTION_NO=🙅 Не смотрю
