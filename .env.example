# Telegram
BOT_TOKEN=123456:your-bot-token

# Один или несколько чатов через запятую — туда уходят карточка и опрос
CHAT_IDS=-1001234567890,-1002400308378
# Для одного чата можно использовать CHAT_ID (обратная совместимость):
# CHAT_ID=-1001234567890

# Schedule (ежедневно в 12:00 по Europe/Minsk)
CRON_SCHEDULE=0 12 * * *
TIMEZONE=Europe/Minsk

# Location
CITY_NAME=Минск
LATITUDE=53.9
LONGITUDE=27.5667

# Card
CARD_WIDTH=1080
CARD_HEIGHT=1080
OUTPUT_PATH=output/weather-card.png

# Poll
POLL_QUESTION=Кто сегодня идёт смотреть закат?
POLL_OPTION_YES=Приду
POLL_OPTION_NO=Не приду
POLL_OPTION_MAYBE=Возможно
